{
  "name": "BDHousing — Workflow A: Outgoing Calls",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bdhousing/outgoing-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1-webhook",
      "name": "Webhook (Laravel → n8n)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 300],
      "webhookId": "PLACEHOLDER-BDHOUSING-OUTGOING"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{$json.headers['x-n8n-secret']}}",
              "rightValue": "PLACEHOLDER_N8N_WEBHOOK_SECRET",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{$json.body.call.mode}}",
              "rightValue": "live",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a2-guard",
      "name": "Secret + Mode Guard (manual pause: disable this node to halt everything)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "// duplicate prevention: skip if Laravel already flagged an active call\nconst b = $json.body.call;\nif (b.active_call_exists) {\n  throw new Error(`Active call already exists for lead ${b.lead_id}`);\n}\nif (!b.consent_granted) {\n  throw new Error(`No consent for lead ${b.lead_id} — refusing to dial`);\n}\nreturn [{ json: b }];"
      },
      "id": "a3-checks",
      "name": "Consent + Duplicate Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.retellai.com/v2/create-phone-call",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer PLACEHOLDER_RETELL_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent_id\": \"PLACEHOLDER_RETELL_AGENT_ID\",\n  \"from_number_id\": \"PLACEHOLDER_RETELL_PHONE_NUMBER_ID\",\n  \"to_number\": \"{{$json.phone}}\",\n  \"retell_llm_dynamic_variables\": {\n    \"customer_name\": \"{{$json.customer_name}}\",\n    \"preferred_language\": \"{{$json.preferred_language}}\",\n    \"property_interest\": \"{{$json.property_interest}}\",\n    \"call_purpose\": \"{{$json.call_purpose}}\"\n  }\n}",
        "options": {
          "retry": { "maxTries": 3, "waitBetweenTries": 5000 },
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "a4-retell",
      "name": "Retell — Create Phone Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PLACEHOLDER_LARAVEL_API_URL/api/ai-calls/{{$json.body?.call_id || $('Webhook (Laravel → n8n)').item.json.body.call.id}}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-N8N-Secret", "value": "PLACEHOLDER_N8N_WEBHOOK_SECRET" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.error || $json.message ? 'failed' : 'initiated', provider_call_id: $json.call?.id, error_message: $json.message || null }) }}",
        "options": { "retry": { "maxTries": 3, "waitBetweenTries": 5000 } }
      },
      "id": "a5-laravel",
      "name": "Laravel — Update Call Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ ok: true }) }}", "options": {} },
      "id": "a6-respond",
      "name": "Respond to Laravel",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a7-failure",
      "name": "Failure Logger",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PLACEHOLDER_LARAVEL_API_URL/api/ai-calls/{{$('Webhook (Laravel → n8n)').item.json.body.call.id}}/status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', error_message: $json.error }) }}",
        "options": {}
      },
      "id": "a8-failreport",
      "name": "Report Failure to Laravel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 500]
    }
  ],
  "connections": {
    "a1-webhook": { "main": [[{ "node": "a2-guard", "type": "main", "index": 0 }]] },
    "a2-guard": { "main": [[{ "node": "a3-checks", "type": "main", "index": 0 }]] },
    "a3-checks": { "main": [[{ "node": "a4-retell", "type": "main", "index": 0 }]] },
    "a4-retell": {
      "main": [
        [
          { "node": "a5-laravel", "type": "main", "index": 0 },
          { "node": "a7-failure", "type": "main", "index": 0 }
        ]
      ]
    },
    "a5-laravel": { "main": [[{ "node": "a6-respond", "type": "main", "index": 0 }]] },
    "a7-failure": { "main": [[{ "node": "a8-failreport", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true },
  "tags": ["bdhousing", "ai-calling"]
}
