# BDHousing voice calling — copy to .env and fill in. Never commit .env.
# The same variables are reused by server/retell-proxy.mjs, n8n, and any other site
# that runs this proxy. GitHub Pages cannot read this file.

# Secret Retell API key. In the Retell dashboard this key is named "bdhousing-voice".
# It must be the key that shows the webhook badge (signature verification uses it).
# Leave blank here. Do not invent a value and do not paste the key into git.
RETELL_API_KEY=

# Published agents in workspace BDHousing (org_b6zBp6LIqhl3aV7n).
RETELL_INBOUND_AGENT_ID=agent_dc1a3df8b89476e4868363ee98
RETELL_OUTBOUND_AGENT_ID=agent_2603c7b2c919d2677273e30634

# E.164 number bought or imported in Retell and bound to the agents above.
# Leave empty until that number exists. Web calls do not need it.
RETELL_FROM_NUMBER=

# Optional. Retell public key (prefix public_key_), domain-allowlisted.
# Safe to put in docs/retell-config.js. This is not the secret API key.
RETELL_PUBLIC_KEY=

# ---- Proxy (server/retell-proxy.mjs) ----
PORT=8787
# Comma-separated browser origins allowed to call the proxy. Localhost is always allowed.
ALLOWED_ORIGINS=https://rabinmia975.github.io
# If set, POST routes require header X-Proxy-Secret. Use this when the proxy is on the public internet.
PROXY_SHARED_SECRET=

# After the proxy verifies a Retell webhook, it forwards the raw body here (optional).
N8N_INBOUND_WEBHOOK_URL=
# Sent as X-Proxy-Secret / X-N8N-Secret when forwarding. n8n workflows compare against this.
N8N_WEBHOOK_SECRET=

# Optional Laravel status callback used by the n8n workflows. Not required for the Pages demo.
LARAVEL_API_URL=
