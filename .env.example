# ---- AI Calling mode ----
# demo | live  (live requires an authorized admin to enable it in the UI AND real credentials)
AI_CALL_MODE=demo

# ---- Retell AI (live mode only) ----
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_PHONE_NUMBER_ID=
RETELL_WEBHOOK_SECRET=

# ---- n8n ----
N8N_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_SECRET=          # shared secret, sent as X-N8N-Secret header
N8N_OUTGOING_WEBHOOK_PATH=   # workflow A webhook path
N8N_INCOMING_WEBHOOK_PATH=   # workflow B webhook path

# ---- App ----
# Laravel app already defines APP_*, DB_*, etc. — no duplicates needed.
